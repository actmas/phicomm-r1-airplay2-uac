diff --git a/shairport.c b/shairport.c
index 7a06caa..64b10b5 100644
--- a/shairport.c
+++ b/shairport.c
@@ -42,6 +42,43 @@
 #include <sys/wait.h>
 #include <unistd.h>
 
+/* Android 5.1 / Linux 3.10 compatibility for getentropy() and getrandom() */
+ssize_t getrandom(void *buf, size_t buflen, unsigned int flags) {
+  (void)flags;
+  int fd = open("/dev/urandom", O_RDONLY | O_CLOEXEC);
+  if (fd < 0)
+    return -1;
+  size_t total = 0;
+  while (total < buflen) {
+    ssize_t n = read(fd, (char *)buf + total, buflen - total);
+    if (n < 0) {
+      if (errno == EINTR)
+        continue;
+      close(fd);
+      return -1;
+    }
+    if (n == 0)
+      break;
+    total += n;
+  }
+  close(fd);
+  return (ssize_t)total;
+}
+
+int getentropy(void *buffer, size_t length) {
+  if (length > 256) {
+    errno = EIO;
+    return -1;
+  }
+  ssize_t ret = getrandom(buffer, length, 0);
+  if (ret != (ssize_t)length) {
+    if (ret >= 0)
+      errno = EIO;
+    return -1;
+  }
+  return 0;
+}
+
 
